# RPC endpoints (two providers recommended for failover in production)
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# BscScan verification
BSCSCAN_API_KEY=

# Deploy config (defaults to BSC mainnet DEX addresses if unset)
# WBNB=
# V2_FACTORY=
# V3_FACTORY=
TREASURY=
GUARDIAN_SAFE=
SEED_BNB=0

# Never commit a real key. Use a hardware wallet / keystore for mainnet.
# PRIVATE_KEY=
