{
  "name": "inverse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "dev:api": "tsx watch src/services/api.ts",
    "dev:indexer": "tsx watch src/services/indexer.ts",
    "dev:keeper": "tsx watch src/services/keeper.ts",
    "dev:relayer": "tsx watch src/services/relayer.ts",
    "dev:warmer": "tsx watch src/services/warmer.ts",
    "start:api": "node dist/services/api.js",
    "start:indexer": "node dist/services/indexer.js",
    "start:keeper": "node dist/services/keeper.js",
    "start:relayer": "node dist/services/relayer.js",
    "start:warmer": "node dist/services/warmer.js"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/websocket": "10.0.1",
    "@prisma/client": "5.22.0",
    "dotenv": "16.4.5",
    "ethers": "6.13.4",
    "fastify": "4.28.1",
    "pino": "9.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/ws": "8.5.13",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
