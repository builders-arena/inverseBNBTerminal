# ---- Chain ----
CHAIN_ID=56
# Two providers for failover (comma-separated also accepted in RPC_URLS)
RPC_URL_PRIMARY=https://bsc-dataseed.binance.org
RPC_URL_SECONDARY=https://bsc-dataseed1.defibit.io
WS_RPC_URL=wss://bsc-ws-node.nariox.org:443

# ---- Contract addresses (from Deploy.s.sol output) ----
# NOTE: when deployed with a Pyth router, ORACLE_ADDRESS must be the OracleRouter (what the engine uses).
ORACLE_ADDRESS=
VAULT_ADDRESS=
ENGINE_ADDRESS=
SESSION_MANAGER_ADDRESS=
FEE_DISTRIBUTOR_ADDRESS=
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
DEPLOY_BLOCK=0

# ---- Pyth (cross-chain / feed-priced markets, e.g. SOL — all settled in BNB) ----
# On-chain Pyth contract. Mainnet 0x4D7E825f80bDf85e913E0DD2A2D54927e9dE1594; BSC testnet
# 0x5744Cbf430D99456a0A8771208b674F27f8EF0Fb. Leave blank to disable.
PYTH_ADDRESS=
# Hermes base URL. Since the 2026-08-26 "Pyth Pro" upgrade the keyless hermes.pyth.network is gone;
# Hermes is served under dourolabs and needs an API key.
HERMES_URL=https://pyth.dourolabs.app/hermes
# Free Pyth API key (https://app.pyth.com -> "View your API key"), sent as a Bearer token. Required
# for posting updates; without it Hermes returns 401.
PYTH_API_KEY=
# CSV of "synthTokenAddr:0xpythFeedId". synthTokenAddr is the market id registered via
# OracleRouter.setSource + PythAdapter.setFeed. Example SOL/USD feed id shown; pick/confirm per deployment.
# PYTH_MARKETS=0x0000000000000000000000000000000000000501:0xef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
PYTH_MARKETS=
# Post cadence for the warmer; keep well under PythAdapter.maxAge (default 60s).
PYTH_POST_INTERVAL_MS=15000

# ---- Chainlink (push-feed markets — free, no key, no poster) ----
# CSV of market token ids routed to CHAINLINK (OracleRouter.setSource(CHAINLINK)). Chainlink's nodes
# keep the feed fresh on-chain, so there is NO warmer/poster and no key — this list only tells the
# indexer which feed markets to sample for the candle series. Leave PYTH_* unset for a Chainlink-only
# deployment (the warmer's Pyth loop and the keeper's Pyth refresh then idle automatically).
CHAINLINK_MARKETS=

# ---- Uniswap V4 (DEX pools read via StateView, priced on-chain by V4Source behind OracleRouterV4) ----
# The V4 StateView lens + PoolManager singleton. On Robinhood Chain (4663) these are:
# STATE_VIEW_ADDRESS=0xF3334192D15450CdD385c8B70e03f9A6bD9E673b
# POOL_MANAGER_ADDRESS=0x8366a39CC670B4001A1121B8F6A443A643e40951
STATE_VIEW_ADDRESS=
POOL_MANAGER_ADDRESS=
# Earliest block to scan for Initialize events in /v4/pools discovery (defaults to DEPLOY_BLOCK).
V4_FROM_BLOCK=
# CSV of V4 market token ids (registered via OracleRouterV4.setSource(V4) + V4Source.register). Like
# CHAINLINK_MARKETS, this only tells the indexer/warmer which tokens to sample + keep warm; the
# on-chain V4Source prices them. The warmer snapshots these (route 3) just like V2 (route 1).
V4_MARKETS=

# ---- Database ----
DATABASE_URL=postgresql://inverse:inverse@localhost:5432/inverse?schema=public

# ---- API ----
API_PORT=8080
API_HOST=0.0.0.0
CORS_ORIGIN=*

# ---- Keeper / relayer / warmer hot wallets (each ≤ 0.3 BNB; never commit real keys) ----
KEEPER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
WARMER_PRIVATE_KEY=
# Comma-separated token addresses the warmer keeps fresh
WARM_TOKENS=

# ---- Alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Tuning ----
INDEXER_POLL_MS=3000
INDEXER_CONFIRMATIONS=1
KEEPER_POLL_MS=3000
WARMER_INTERVAL_MS=60000
LOG_LEVEL=info
